{
  "name": "velox-sistema-gestao",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "node server.cjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests.mjs timeclock.test.mjs backend.test.mjs",
    "test:preflight": "node --test testes/preflight.mjs testes/backup.test.mjs",
    "prepare:uso-real": "node frontend/prepare-pages.mjs",
    "build:producao": "npm run prepare:uso-real && vite build --config frontend/vite.producao.config.js",
    "preview:producao": "vite preview --config frontend/vite.producao.config.js --host 0.0.0.0",
    "check:producao": "npm run test && npm run test:preflight && npm run build:producao && node testes/check-build.mjs",
    "dev:vite": "vite --host 0.0.0.0",
    "test:timeclock": "node --test timeclock.test.mjs",
    "test:backend": "node --test backend.test.mjs"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  },
  "stackblitz": {
    "startCommand": "npm run dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.78.0",
    "pdf-lib": "^1.17.1",
    "scrypt-js": "^3.0.1"
  }
}
